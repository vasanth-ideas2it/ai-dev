# ── Database ────────────────────────────────────────────────────────────────
# JDBC URL — in prod compose the hostname is the "postgres" service name
DB_URL=jdbc:postgresql://postgres:5432/crm
DB_USER=crm
DB_PASSWORD=change_me

# ── JWT ─────────────────────────────────────────────────────────────────────
# Must be at least 256-bit (32-char) random string in production
JWT_SECRET=change_me_replace_with_32_plus_char_random_secret

# ── CORS ────────────────────────────────────────────────────────────────────
# Origin that the backend allows — matches where the frontend is served from
FRONTEND_URL=http://localhost

# ── pgAdmin (dev convenience — not used in prod compose) ────────────────────
PGADMIN_DEFAULT_EMAIL=admin@crm.local
PGADMIN_DEFAULT_PASSWORD=change_me
